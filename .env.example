# Plantilla de configuración del proveedor LLM. Copiala a `.env` y completala.
# `.env` está en .gitignore: nunca se commitea.

# --- AWS Bedrock (criterio de aprobación del M3: Nova Lite) ---
BEDROCK_MODEL_ID="amazon.nova-lite-v1:0"
AWS_REGION="us-east-1"
# Credenciales temporales del portal SSO (caducan; hay que renovarlas):
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# --- Alternativa: Ollama local (no cumple el criterio de aprobación) ---
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_MODEL="llama3.1:8b"
